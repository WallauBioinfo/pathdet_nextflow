// Define o caminho base de dados por omissão
def db_path = params.datadir ?: "${launchDir}/assets/db"

params {

    // Ficheiros de entrada e resultados
    input_csv = "${launchDir}/assets/reads/reads_test.csv"
    out       = "${launchDir}/results"
    datadir   = db_path
    cleanup_work_on_success = true

    // Parâmetros de QC (Fastp / BBDuk)
    fastp_qualified_phred = 30
    fastp_n_base_limit    = 20
    fastp_length_required = 80
    fastp_trim_front1     = 15
    fastp_trim_tail1      = 1
    fastp_trim_tail2      = 1

    bbduk_entropy         = 0.5
    bbduk_entropywindow   = 10
    bbduk_entropyk        = 5

    // Bases de Dados de Dehosting (p02_hgs)
    kraken2_grch38        = "${db_path}/kraken2/human"
    bowtie2_host          = "${db_path}/bowtie2/GRCh38_noalt_as/GRCh38_noalt_as"
    hisat2_grch38r        = "${db_path}/hisat2/grch38_tran/genome_tran"
    blast_host2           = "${db_path}/blast/t2t/GCF_009914755.1_T2T-CHM13v2.0_genomic"

    // Análise Rápida por k-meros (p03_rapid)
    pathdb1_db            = "${db_path}/kraken2/k2_pluspf_20241228"

    // Parâmetros BLAST (p03_blast) - Ajustado split_size para 50000 conforme o Bash original
    blast_nt              = "${db_path}/blast/nt/nt"
    split_size            = 50000
    blast_threads         = 20

    // Database de genomas locais
    ncbi_genome_dir       = "${db_path}/ncbi_genome"
    ncbi_lineage_tsv      = "${db_path}/ncbi_genome/reference/refseq_lineage_taxid_fasta.tsv"

    // Mapping parameters (p05_map)
    map_threads           = 16

    // SparK (gráficos SVG de cobertura); no bash: $CONDA_PREFIX/opt/git/SparK/SparK.py
    spark_script          = "${System.getenv('CONDA_PREFIX')}/opt/git/SparK/SparK.py"
}

process {
    // Configuração para submeter jobs no Slurm (se aplicável ao cluster)
    // executor = 'slurm' 

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4 GB'
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = '16 GB'
    }
    withLabel: 'process_high' {
        cpus   = { params.blast_threads ?: 16 }
        memory = '32 GB'
    }
}

cleanup = params.cleanup_work_on_success