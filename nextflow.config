// ===========================================================================
// pathdet_nextflow - configuration
// ===========================================================================
// NOTE: process directives below only use `params`, `task` and plain Groovy
// (no helper closures/functions): Nextflow's config parser does not allow them.

def db_path = params.datadir ?: "${launchDir}/assets/db"

// ---------------------------------------------------------------------------
// Compute limits of this run
//   * detected from the scheduler (PBS / SLURM) or from the machine;
//   * override on the command line:  --max_cpus 16 --max_memory 120   (memory in GB)
// Read before the params block so that command-line values are honoured.
// ---------------------------------------------------------------------------
def cpus_limit = ((params.max_cpus ?:
                   System.getenv('PBS_NP') ?:
                   System.getenv('PBS_NUM_PPN') ?:
                   System.getenv('NCPUS') ?:
                   System.getenv('SLURM_CPUS_ON_NODE') ?:
                   Runtime.runtime.availableProcessors()) as int)

// MemTotal is the first line of /proc/meminfo; keep 10% for the OS
def meminfo_gb = new File('/proc/meminfo').exists() ?
        (int) Math.floor((new File('/proc/meminfo').readLines()[0].tokenize()[1] as long) / 1048576.0 * 0.9) : 16
def mem_limit_gb = ((params.max_memory ?: meminfo_gb) as int)

params {

    // Ficheiros de entrada e resultados
    input_csv = "${launchDir}/assets/reads/reads_test.csv"
    out       = "${launchDir}/results"
    datadir   = db_path
    cleanup_work_on_success = true

    // ---- Resources ----------------------------------------------------------
    max_cpus   = cpus_limit
    max_memory = mem_limit_gb

    // Nothing is hard-coded inside the modules: every tool receives task.cpus.
    // Override ONE process (name = process name):
    //     --threads_RUN_BLASTN 8        CPUs/threads of that process
    //     --mem_RAPID_ANALYSIS 120      memory of that process, in GB
    // or in a params file / custom config:
    //     params.threads = [RUN_BLASTN: 8, QUALITY_CONTROL: 4]
    //     params.mem     = [RAPID_ANALYSIS: 120]
    threads       = null   // map, e.g. [RUN_BLASTN: 8]; null = use the defaults below
    mem           = null   // map in GB, e.g. [RAPID_ANALYSIS: 120]
    blast_threads = null      // legacy alias of --threads_RUN_BLASTN

    // Default threads per process (always capped to max_cpus).
    // RUN_BLASTN default = half of max_cpus (see withName below).
    threads_default = [
        QUALITY_CONTROL          : 8,
        DEHOST_KRAKEN2           : 8,
        DEHOST_BOWTIE2           : 8,
        DEHOST_HISAT2            : 8,
        DEHOST_BLASTN            : 4,
        RAPID_ANALYSIS           : 4,   // kraken2 time is dominated by loading the database
        SPLIT_FASTA              : 1,   // single-threaded python
        MERGE_AND_KRONA          : 2,   // Krona tools are single-threaded
        FETCH_REFERENCE_GENOMES  : 1,
        ALIGN_AND_VARIANT_CALLING: 4
    ]

    // Default memory (GB) of the first attempt, multiplied by task.attempt on retry.
    // RAPID_ANALYSIS and DEHOST_KRAKEN2 are sized from the database (see withName below).
    mem_default = [
        QUALITY_CONTROL          : 8,
        DEHOST_BOWTIE2           : 8,
        DEHOST_HISAT2            : 12,
        DEHOST_BLASTN            : 4,
        RUN_BLASTN               : 60,  // nt is memory-mapped (reclaimable page cache), not heap
        MERGE_AND_KRONA          : 8,
        ALIGN_AND_VARIANT_CALLING: 8
    ]

    // QC parameters (Fastp / BBDuk)
    fastp_qualified_phred = 30
    fastp_n_base_limit    = 20
    fastp_length_required = 80
    fastp_trim_front1     = 15
    fastp_trim_tail1      = 1
    fastp_trim_tail2      = 1

    bbduk_entropy         = 0.5
    bbduk_entropywindow   = 10
    bbduk_entropyk        = 5

    // Dehosting databases (p02_hgs)
    kraken2_grch38        = "${db_path}/kraken2/human"
    bowtie2_host          = "${db_path}/bowtie2/GRCh38_noalt_as/GRCh38_noalt_as"
    hisat2_grch38r        = "${db_path}/hisat2/grch38_tran/genome_tran"
    blast_host2           = "${db_path}/blast/t2t/GCF_009914755.1_T2T-CHM13v2.0_genomic"

    // Rapid parameters (p03_rapid)
    pathdb1_db            = "${db_path}/kraken2/k2_pluspf_20241228"

    // Blast parameters (p03_blast)
    blast_nt              = "${db_path}/blast/nt/nt"
    // split_size counts LINES of the FASTA (2 lines per read): 50000 -> 25000 reads per chunk
    split_size            = 50000
    // Chunks (from all samples) searched together by ONE blastn. A blastn against nt costs
    // about one pass over the database no matter how few reads it has, so a larger value
    // amortises that pass over more samples; keep it bounded for very large runs.
    blast_batch_chunks    = 50

    // local genome databases
    ncbi_genome_dir       = "${db_path}/ncbi_genome"
    ncbi_lineage_tsv      = "${db_path}/ncbi_genome/reference/refseq_lineage_taxid_fasta.tsv"

    // SparK parameters ( SVG cover plots); $CONDA_PREFIX/opt/git/SparK/SparK.py
    spark_script          = "${System.getenv('CONDA_PREFIX')}/opt/git/SparK/SparK.py"
}

process {
    // Whatever is asked for is capped to what this machine / allocation really has.
    resourceLimits = [ cpus: cpus_limit, memory: mem_limit_gb.GB, time: 72.h ]

    // Generic policy: user override > default table > 1 CPU / 4 GB
    // (params.containsKey avoids Nextflow's "undefined parameter" warning for unset overrides)
    cpus = {
        def n   = task.process.tokenize(':').last()
        def own = params.containsKey('threads_' + n) ? params['threads_' + n] : null
        Math.min(((own ?: params.threads?.get(n) ?: params.threads_default?.get(n) ?: 1) as int),
                 (params.max_cpus as int))
    }
    memory = {
        def n   = task.process.tokenize(':').last()
        def own = params.containsKey('mem_' + n) ? params['mem_' + n] : null
        (((own ?: params.mem?.get(n) ?: params.mem_default?.get(n) ?: 4) as int) * task.attempt).GB
    }
    time = { (12 * task.attempt).h }

    // out-of-memory (137) / walltime (140) / killed (143, 247): retry with more memory
    errorStrategy = { task.exitStatus in [137, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    // blastn: half of the CPUs by default, so the other samples keep running meanwhile
    withName: 'RUN_BLASTN' {
        cpus = {
            def own = params.containsKey('threads_RUN_BLASTN') ? params.threads_RUN_BLASTN : null
            Math.min(((own ?: params.threads?.get('RUN_BLASTN') ?: params.blast_threads ?:
                      Math.max(1, (int) ((params.max_cpus as int) / 2))) as int),
                     (params.max_cpus as int))
        }
    }

    // kraken2 loads the whole hash table into RAM: memory follows the database size
    withName: 'RAPID_ANALYSIS' {
        memory = {
            def hash = new File(params.pathdb1_db + '/hash.k2d')
            def auto = hash.exists() ? (int) Math.ceil(hash.length() / 1073741824.0) + 8 : 16
            def own  = params.containsKey('mem_RAPID_ANALYSIS') ? params.mem_RAPID_ANALYSIS : null
            (((own ?: params.mem?.get('RAPID_ANALYSIS') ?: Math.max(16, auto)) as int) * task.attempt).GB
        }
    }
    withName: 'DEHOST_KRAKEN2' {
        memory = {
            def hash = new File(params.kraken2_grch38 + '/hash.k2d')
            def auto = hash.exists() ? (int) Math.ceil(hash.length() / 1073741824.0) + 4 : 8
            def own  = params.containsKey('mem_DEHOST_KRAKEN2') ? params.mem_DEHOST_KRAKEN2 : null
            (((own ?: params.mem?.get('DEHOST_KRAKEN2') ?: Math.max(8, auto)) as int) * task.attempt).GB
        }
    }
}

// Local executor (the whole pipeline runs inside one scheduler job): never schedule more
// than the CPUs / memory of the allocation, so heavy tasks wait instead of oversubscribing.
executor {
    cpus   = cpus_limit
    memory = "${mem_limit_gb} GB"
}

cleanup = params.cleanup_work_on_success
